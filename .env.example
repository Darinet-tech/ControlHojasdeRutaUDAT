# Copie este archivo como ".env" (junto a manage.py) y ajuste los valores. El ".env" NO se sube a git.
# Si no existe ".env" (o no hay POSTGRES_DB) el sistema usa SQLite, que solo sirve para pruebas.

# --- Base de datos PostgreSQL ---
POSTGRES_DB=mesa_pruebas_db
POSTGRES_USER=mesa
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Seguridad ---
# Clave secreta larga y aleatoria (50+ caracteres). Generar:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 1 solo en desarrollo. En el servidor déjelo en 0 (o quite la línea).
DJANGO_DEBUG=0
# Nombre(s) con que los usuarios abren la app, separados por comas (sin http://). Ej.: mesa.etecsa.cu,10.1.2.3
DJANGO_ALLOWED_HOSTS=mesa.etecsa.cu
# Dirección(es) completas de la app, con http:// o https:// (necesarias para iniciar sesión). Ej.: https://mesa.etecsa.cu
DJANGO_CSRF_TRUSTED_ORIGINS=https://mesa.etecsa.cu
# Si la app se sirve por HTTPS (recomendado): 1. Si todavía va por http (sin certificado): 0.
DJANGO_HTTPS=1
# Si hay un proxy/IIS/nginx delante que termina el HTTPS y envía X-Forwarded-Proto: 1
DJANGO_TRAS_PROXY=0
# Si el proxy ya redirige de http a https, ponga 0 para no redirigir dos veces.
DJANGO_SSL_REDIRECT=1
# Puerto y dirección en que escucha el servidor de la app (iniciar_servidor.bat).
SERVIDOR_PUERTO=8000

# --- Informe diario por correo (corte a las 16:00) ---
EMAIL_HOST=smtp.etecsa.cu
EMAIL_PORT=25
INFORME_REMITENTE=Unidad de Asistencia Técnica (UDAT) <leonel.hinojosa@etecsa.cu>

# --- Opcionales ---
# HORA_CIERRE_AUTOMATICO=21:00
# LOGIN_LIMITE=10/min
